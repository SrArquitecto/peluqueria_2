---
import "../styles/global.css";

const { titulo, descripcion, color, colorContenido, imagen } = Astro.props;

// El color principal de cada cliente sustituye al del tema sin tocar el diseño.
const estilo = [
  color && `--color-primary: ${color}`,
  colorContenido && `--color-primary-content: ${colorContenido}`,
]
  .filter(Boolean)
  .join("; ");
---
<!doctype html>
<html lang="es" class="scroll-smooth" style={estilo || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <slot name="head" />
  </head>
  <body>
    {imagen ? (
      <>
        <div class="pointer-events-none fixed inset-x-0 top-0 -z-30 h-lvh bg-[linear-gradient(to_bottom,#b98a62,color-mix(in_oklab,var(--color-base-300)_60%,#b98a62)_25%,var(--color-base-100)_75%)]"></div>
        <div class="pointer-events-none fixed inset-x-0 top-0 -z-20 flex h-lvh items-start justify-center md:items-center">
          <img src={imagen} alt="" class="max-h-full max-w-full md:max-h-[91%] md:max-w-[91%] [mask-image:linear-gradient(to_right,transparent,black_20%,black_80%,transparent),linear-gradient(to_bottom,transparent,black_12%,black_88%,transparent)] [mask-composite:intersect]" />
        </div>
        <div class="pointer-events-none fixed inset-0 -z-10 bg-base-100/50 md:bg-gradient-to-r md:from-base-30 md:from-25% md:via-base-100/60 md:via-30% md:to-base-100/15"></div>
      </>
    ) : (
      <div class="pointer-events-none fixed inset-0 -z-20 bg-[linear-gradient(to_bottom,var(--color-base-100),color-mix(in_oklab,var(--color-secondary)_22%,var(--color-base-100)))]"></div>
    )}
    <slot />
  </body>
</html>
