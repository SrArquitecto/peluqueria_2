---
import "../styles/global.css";

const { titulo, descripcion, color, colorContenido, imagen, imagenDerecha } = Astro.props;

// El color principal de cada cliente sustituye al del tema sin tocar el diseño.
const estilo = [
  color && `--color-primary: ${color}`,
  colorContenido && `--color-primary-content: ${colorContenido}`,
]
  .filter(Boolean)
  .join("; ");
---
<!doctype html>
<html lang="es" class="scroll-smooth" style={estilo || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <slot name="head" />
  </head>
  <body class="relative">
    <div class="pointer-events-none fixed inset-0 -z-20 bg-[linear-gradient(to_bottom,var(--color-base-100),color-mix(in_oklab,var(--color-secondary)_22%,var(--color-base-100)))]"></div>
    {(imagen || imagenDerecha) && (
      <>
        {imagen && (
          <img src={imagen} alt="" fetchpriority="high" class="pointer-events-none fixed inset-y-0 left-0 -z-10 hidden h-full w-[32%] object-cover object-left-top opacity-100 md:block [mask-image:linear-gradient(to_left,transparent,black_75%)]" />
        )}
        {imagenDerecha && (
          <img src={imagenDerecha} alt="" class="pointer-events-none fixed inset-y-0 right-0 -z-10 hidden h-full w-[32%] object-cover object-top opacity-80 md:block [mask-image:linear-gradient(to_right,transparent,black_80%)]" />
        )}
        <img src={imagen || imagenDerecha} alt="" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[46svh] w-full object-cover object-[50%_20%] [mask-image:linear-gradient(to_bottom,black_55%,transparent)] md:hidden" />
      </>
    )}
    <slot />
  </body>
</html>
