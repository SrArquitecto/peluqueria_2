---
const { categorias } = Astro.props;
---
<section id="servicios" class="mx-auto max-w-6xl scroll-mt-16 px-4 py-20">
  <div class="text-center">
    <span class="mx-auto mb-6 block h-px w-16 bg-primary" aria-hidden="true"></span>
    <h2 class="font-display text-4xl font-semibold md:text-5xl">Servicios y tarifas</h2>
  </div>
  <div class="mx-auto mt-12 max-w-3xl rounded-box border border-base-300 bg-base-100/95 p-2 shadow-sm">
    <div class="space-y-12 rounded-box border border-base-300 p-6 md:p-12">
      {categorias.map((c) => (
        <div>
          <h3 class="flex items-center gap-4 text-center text-sm font-semibold uppercase tracking-[0.25em] text-primary">
            <span class="h-px flex-1 bg-base-300" aria-hidden="true"></span>
            {c.categoria}
            <span class="h-px flex-1 bg-base-300" aria-hidden="true"></span>
          </h3>
          <ul class="mt-6 space-y-4">
            {c.items.map((i) => (
              <li>
                <div class="flex items-end gap-3">
                  <span class="font-display text-lg">{i.nombre}</span>
                  <span class="mb-1.5 flex-1 border-b border-dotted border-base-content/30" aria-hidden="true"></span>
                  <span class="font-semibold tabular-nums">{i.precio}</span>
                </div>
                {i.descripcion && <p class="mt-1 max-w-[55ch] text-sm italic text-base-content/70">{i.descripcion}</p>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
